   <direction>
    <direction-type>
     <words default-x="19" default-y="-199" justify="left" valign="middle" font-family="Palatino" font-style="normal" font-size="12.7891" font-weight="normal">*The title of this piece (which is either a galliard or a coranto) is sometimes given as:</words>
     <words justify="left" valign="middle" font-family="Palatino" font-style="normal" font-size="12.7891" font-weight="normal">As if fell upon a holly eve, or</words>
     <words justify="left" valign="middle" font-family="Palatino" font-style="normal" font-size="12.7891" font-weight="normal">As it fell on a holy eve.</words>
     <words justify="left" valign="middle" font-family="Palatino" font-style="normal" font-size="12.7891" font-weight="normal">The title is difficult to read in the source but appears to be:</words>
     <words justify="left" valign="middle" font-family="Palatino" font-style="normal" font-size="12.7891" font-weight="normal">As if fell on a holiday.</words>
    </direction-type>
    <voice>1</voice>
    <staff>1</staff>
   </direction>
