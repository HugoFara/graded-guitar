  <credit page="1">
    <credit-type>subtitle</credit-type>
    <credit-words default-x="595.44" default-y="1621.45" justify="center" valign="top" font-size="14">Россия богата, а бедный народ. При разных режимаж, Был нищенский МРОТ, приходится
</credit-words>
    <credit-words>часто страну защищать. Пытаемся как то власть поменять,защищаем других,посылаем
</credit-words>
    <credit-words>конвой. Решили заняться собой! 
</credit-words>
    <credit-words> 
</credit-words>
