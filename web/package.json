    "test": "vitest run",
    "test:e2e": "playwright test",
    "report:e2e": "node scripts/render-report.mjs",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "svelte-spa-router": "^4.0.2"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
