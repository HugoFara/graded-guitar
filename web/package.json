{
  "name": "graded-guitar-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-corpus.mjs",
    "predev": "node scripts/copy-corpus.mjs",
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "report:e2e": "node scripts/render-report.mjs",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.4.7",
    "svelte-spa-router": "^4.0.1"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.2",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^25.0.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
